  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, publishedAt])
  @@index([tenantId])
  @@map("notifications")
}

model NotificationRead {
  id             String   @id @default(uuid()) @db.Uuid
  notificationId String   @map("notification_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

model Activity {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  websiteId String? @map("website_id") @db.Uuid
  type      String
  summaryFa String  @map("summary_fa")
  summaryEn String  @map("summary_en")
  metadata  Json?

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([websiteId, createdAt(sort: Desc)])
  @@map("activities")
}

model AuditRecord {
  id         String  @id @default(uuid()) @db.Uuid
  actorId    String? @map("actor_id") @db.Uuid
  action     String
  entityType String  @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String? @map("ip_address")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_records")
}

model OperationalAction {
  id             String                  @id @default(uuid()) @db.Uuid
  websiteId      String                  @map("website_id") @db.Uuid
  requesterId    String                  @map("requester_id") @db.Uuid
  type           OperationalActionType
  status         OperationalActionStatus @default(QUEUED)
  idempotencyKey String?                 @unique @map("idempotency_key")
  resultMessage  String?                 @map("result_message")
  startedAt      DateTime?               @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?               @map("finished_at") @db.Timestamptz(6)

  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  requester User    @relation("OperationalActionRequester", fields: [requesterId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([websiteId, createdAt(sort: Desc)])
  @@index([status])
  @@map("operational_actions")
}

model IdempotencyRecord {
  id           String  @id @default(uuid()) @db.Uuid
  scope        String
  key          String
  actorId      String? @map("actor_id") @db.Uuid
  responseJson Json    @map("response_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

/// Tenant-targeted one-way staff → customer messages (پیام‌های یونیکسی).
/// Distinct from Notification (News) and ticket thread messages.
model UnixseeMessage {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  authorId      String               @map("author_id") @db.Uuid
  websiteId     String?              @map("website_id") @db.Uuid
  status        UnixseeMessageStatus @default(DRAFT)
  title         String
  body          String
  contentLocale String               @map("content_locale") @db.VarChar(8)
  links         Json?
  publishedAt   DateTime?            @map("published_at") @db.Timestamptz(6)
  withdrawnAt   DateTime?            @map("withdrawn_at") @db.Timestamptz(6)

  tenant      Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author      User                       @relation("UnixseeMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  website     Website?                   @relation(fields: [websiteId], references: [id], onDelete: SetNull)
  attachments UnixseeMessageAttachment[]
  reads       UnixseeMessageRead[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@index([status, publishedAt])
  @@map("unixsee_messages")
}

model UnixseeMessageAttachment {
  id          String @id @default(uuid()) @db.Uuid
  messageId   String @map("message_id") @db.Uuid
  fileName    String @map("file_name")
  contentType String @map("content_type")
  sizeBytes   Int    @map("size_bytes")
  storageKey  String @map("storage_key")

  message UnixseeMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([messageId])
  @@map("unixsee_message_attachments")
}

model UnixseeMessageRead {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz(6)

  message UnixseeMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("unixsee_message_reads")
}

enum NewsletterSubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

/// Public newsletter intake. Nest owns persistence for Phase 1; mailing-provider
/// / WordPress sync remains deferred.
model NewsletterSubscription {
  id             String                         @id @default(uuid()) @db.Uuid
  email          String                         @unique
  locale         String?
  source         String?
  status         NewsletterSubscriptionStatus   @default(ACTIVE)
  consentedAt    DateTime                       @default(now()) @map("consented_at") @db.Timestamptz(6)
  unsubscribedAt DateTime?                      @map("unsubscribed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("newsletter_subscriptions")
}

enum ContactMessageSubject {
  managedServer
  migrationOptimization
  woocommerceSupport
  seo
  graphicDesign
  productDataEntry
  socialMedia
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

/// Public contact-us intake. Nest owns persistence for Phase 1; staff inbox
/// and notification email remain deferred.
model ContactMessage {
  id              String               @id @default(uuid()) @db.Uuid
  subject         ContactMessageSubject
  fullName        String               @map("full_name")
  email           String
  phone           String
  website         String?
  activityBasin   String?              @map("activity_basin")
  message         String
  attachmentKeys  Json                 @default("[]") @map("attachment_keys")
  locale          String?
  source          String?
  status          ContactMessageStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([createdAt])
  @@index([email])
  @@map("contact_messages")
}
