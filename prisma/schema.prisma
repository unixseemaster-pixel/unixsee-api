generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  USER
}

model User {
  id          String  @id @default(uuid()) @db.Uuid
  email       String? @unique
  username    String  @unique
  password    String
  fullName    String? @map("full_name")
  phoneNumber String? @map("phone_number")
  role        Role    @default(USER)
  hashedRt    String? @map("hashed_rt")

  websites Website[]
  vps      Vps[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Server {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  ipAddress String   @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vpsNodes Vps[]

  @@map("servers")
}

model Vps {
  id        String   @id @default(uuid()) @db.Uuid
  serverId  String   @map("server_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  machineId String   @unique @map("machine_id") // Extracted from /etc/machine-id
  name      String
  secretKey String   @map("secret_key") // Pre-shared key utilized for agent HMAC authentication
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  websites   Website[]
  vpsMetrics VpsMetric[]
  webMetrics WebMetric[]

  @@map("vps_nodes")
}

// APPEND-ONLY IMMUTABLE TIME-SERIES PROFILE 1: VPS Telemetry
model VpsMetric {
  recordedAt              DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  vpsId                   String   @map("vps_id") @db.Uuid
  cpuUsagePercent         Int      @map("cpu_usage_percent")
  memoryTotalMB           Int      @map("memory_total_mb")
  memoryUsedMB            Int      @map("memory_used_mb")
  liteSpeedConnections    Int      @map("litespeed_connections") // Global server load telemetry
  diskReadBytesPerSecond  BigInt   @map("disk_read_bytes_per_second") // Simultaneous download capacity tracking
  diskWriteBytesPerSecond BigInt   @map("disk_write_bytes_per_second") // Simultaneous upload capacity tracking
  diskIops                Int      @map("disk_iops") // Raw Admin disk performance check
  storageTotalMB          Int      @map("storage_total_mb") // Capacity profiles
  storageAvailableMB      Int      @map("storage_available_mb") // User storage checking limits
  networkRxBytesPerSecond BigInt   @map("network_rx_bytes_per_second")
  networkTxBytesPerSecond BigInt   @map("network_tx_bytes_per_second")

  vps Vps @relation(fields: [vpsId], references: [id], onDelete: Cascade)

  @@id([recordedAt, vpsId]) // Composite Primary Key critical for TimescaleDB Hypertables
  @@map("vps_metrics")
}

model Website {
  id     String @id @default(cuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  vpsId  String @map("vps_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  domain   String  @unique
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  metrics WebsiteMetric[]
  ssl     SSLCertificate?

  @@map("websites")
}

model WebMetric {
  recordedAt         DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  vpsId              String   @map("vps_id") @db.Uuid
  websiteId          String   @map("website_id") @db.Uuid
  concurrentRequests Int      @map("concurrent_requests") // Scraped live from LiteSpeed virtual host reports

  vps     Vps     @relation(fields: [vpsId], references: [id], onDelete: Cascade)
  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@id([recordedAt, websiteId]) // Composite Primary Key critical for TimescaleDB Hypertables
  @@map("web_metrics")
}

model SSLCertificate {
  id        String @id @default(uuid()) @db.Uuid
  websiteId String @unique @map("website_id") @db.Uuid

  // High-Level Data (User & Admin Interface)
  issuer    String?
  subject   String?
  validFrom DateTime? @map("valid_from")
  validTo   DateTime? @map("valid_to")
  isValid   Boolean   @default(true) @map("is_valid")

  // Technical Telemetry (Admin Debugging & Automation)
  serialNumber    String? @map("serial_number")
  isAutoRenewable Boolean @default(true) @map("is_auto_renewable") // Tracks DirectAdmin integration states
  statusMessage   String? @map("status_message") // e.g., "CERT_HAS_EXPIRED" or "ERR_TLS_CERT_ALTNAME_INVALID"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("ssl_certificates")
}
