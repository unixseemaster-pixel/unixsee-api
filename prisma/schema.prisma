generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  TENANT
  USER
}

enum UserAccountStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  ADMIN
  VIEWER
}

enum VpsNodeStatus {
  UNKNOWN
  ONLINE
  DEGRADED
  OFFLINE
}

enum WebsiteProbeSource {
  AGENT
  BACKEND
  EXTERNAL
}

enum WebsiteLifecycleStatus {
  ACTIVE
  SUSPENDED
  RETIRED
}

enum AlertSeverity {
  MONITORING
  WARNING
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  SUPPRESSED
}

enum OtpContext {
  LOGIN
  MONITORING_ACCESS
  PHONE_VERIFY
  EMAIL_VERIFY
}

enum AuthorizationCaseStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_MORE_INFO
  REJECTED
  APPROVED
}

enum ContactChallengeState {
  UNVERIFIED
  PENDING
  VERIFIED
  SKIPPED_ALREADY_VERIFIED
}

enum PlanRequestStatus {
  SUBMITTED
  LINKED
  ENABLED
  DECLINED
}

enum ComplementaryRequestStatus {
  SUBMITTED
  ACCEPTED
  QUOTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  WITHDRAWN
  CANCELLED
}

enum WebsiteManagementCoverage {
  UNIXSEE_MANAGED
  EXTERNAL_INFRASTRUCTURE
  UNCLASSIFIED
}

enum ComplementaryWebsiteTargetType {
  EXISTING_WEBSITE
  TYPED_DOMAIN
}

enum ComplementaryWebsiteResolutionState {
  PENDING_ACCEPTANCE
  LINKED
  DEFERRED_NO_TENANT
}

enum ComplementaryAuthorizationState {
  AUTHORIZED
  NOT_AUTHORIZED
  NOT_AUTHORIZED_AT_ACTIVATION
}

enum ComplementaryEngagementPreference {
  ONE_TIME
  RECURRING
  NOT_SURE
}

enum DiscoveryStatus {
  NEW
  REVIEWED
  ASSIGNED
  IGNORED
}

enum EnrollmentTokenStatus {
  ACTIVE
  USED
  REVOKED
  EXPIRED
}

enum TicketStatus {
  SUBMITTED
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketServiceCategory {
  MANAGED_SERVER
  MIGRATION_OPTIMIZATION
  WOOCOMMERCE_SUPPORT
  SEO
  GRAPHIC_DESIGN
  PRODUCT_DATA_ENTRY
  SOCIAL_MEDIA_SUPPORT
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum UnixseeMessageStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum OperationalActionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum OperationalActionType {
  CACHE_CLEAR
  OTHER
}

enum AgentCommandType {
  REFRESH_SITE_STACK
}

enum AgentCommandStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum BillingItemKind {
  MANAGED_PLAN
  COMPLEMENTARY_SERVICE
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  YEARLY
  NONE
}

enum BillingItemStatus {
  SCHEDULED
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum BillingCommercialState {
  ESTIMATED
  QUOTED
  AGREED
  INVOICED_EXTERNALLY
  SETTLED
}

enum BillingCommercialModel {
  FIXED_SCOPE
  RECURRING_RETAINER
  QUOTA_PACKAGE
  MILESTONE_PROJECT
  CUSTOM_QUOTE
}

enum BillingPeriodReason {
  ACTIVATION
  RENEWAL
  PLAN_REPLACEMENT
  ADJUSTMENT
}

model User {
  id              String            @id @default(uuid()) @db.Uuid
  phoneNumber     String?           @unique @map("phone_number")
  email           String?           @unique
  username        String?           @unique
  password        String?
  fullName        String?           @map("full_name")
  role            Role              @default(TENANT)
  authorized      Boolean           @default(false)
  status          UserAccountStatus @default(ACTIVE)
  locale          String            @default("fa")
  hashedRt        String?           @map("hashed_rt")
  suspendedAt     DateTime?         @map("suspended_at") @db.Timestamptz(6)
  suspendedReason String?           @map("suspended_reason")
  phoneVerifiedAt DateTime?         @map("phone_verified_at") @db.Timestamptz(6)
  emailVerifiedAt DateTime?         @map("email_verified_at") @db.Timestamptz(6)
  avatarUrl       String?           @map("avatar_url")

  websites                  Website[]
  vpsNodes                  VpsNode[]
  memberships               Membership[]
  authorizationCases        AuthorizationCase[] @relation("AuthorizationCaseUser")
  decidedAuthorizationCases AuthorizationCase[] @relation("AuthorizationCaseDecider")

  createdPlanRequests     PlanRequest[]                 @relation("PlanRequestCreatedBy")
  linkedPlanRequests      PlanRequest[]                 @relation("PlanRequestLinkedUser")
  complementaryRequests   ComplementaryServiceRequest[] @relation("ComplementaryRequestCreatedBy")
  assignedTickets         Ticket[]                      @relation("TicketAssignee")
  createdTickets          Ticket[]                      @relation("TicketCreator")
  ticketMessages          TicketMessage[]
  notificationReads       NotificationRead[]
  authoredNotifications   Notification[]                @relation("NotificationAuthor")
  unixseeMessageReads     UnixseeMessageRead[]
  authoredUnixseeMessages UnixseeMessage[]              @relation("UnixseeMessageAuthor")
  requestedAgentCommands  AgentCommand[]                @relation("AgentCommandRequester")
  auditRecords            AuditRecord[]                 @relation("AuditActor")
  operationalActions      OperationalAction[]           @relation("OperationalActionRequester")
  billingPeriodRows       BillingPeriodRow[]            @relation("BillingPeriodCreator")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Tenant {
  id          String            @id @default(uuid()) @db.Uuid
  name        String?
  displayName String?           @map("display_name")
  status      UserAccountStatus @default(ACTIVE)

  memberships           Membership[]
  websites              Website[]
  planRequests          PlanRequest[]
  complementaryRequests ComplementaryServiceRequest[]
  tickets               Ticket[]
  activities            Activity[]
  notifications         Notification[]
  unixseeMessages       UnixseeMessage[]
  authorizationCases    AuthorizationCase[]
  billingItems          BillingItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([name])
  @@map("tenants")
}

model Membership {
  id       String         @id @default(uuid()) @db.Uuid
  userId   String         @map("user_id") @db.Uuid
  tenantId String         @map("tenant_id") @db.Uuid
  role     MembershipRole @default(OWNER)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("memberships")
}

/// Customer احراز هویت package for staff review → tenant approval.
model AuthorizationCase {
  id     String                  @id @default(uuid()) @db.Uuid
  userId String                  @map("user_id") @db.Uuid
  status AuthorizationCaseStatus @default(DRAFT)

  nationalId                String                @map("national_id")
  birthDate                 String                @map("birth_date")
  mobile                    String
  mobileChallenge           ContactChallengeState @default(UNVERIFIED) @map("mobile_challenge")
  mobileBelongsToNationalId Boolean               @default(false) @map("mobile_belongs_to_national_id")
  email                     String
  emailChallenge            ContactChallengeState @default(UNVERIFIED) @map("email_challenge")
  province                  String                @default("")
  city                      String                @default("")
  address                   String                @default("")
  postalCode                String                @default("") @map("postal_code")
  nationalIdCardFileName    String?               @map("national_id_card_file_name")
  nationalIdCardStorageKey  String?               @map("national_id_card_storage_key")
  attestedTruthful          Boolean               @default(false) @map("attested_truthful")

  staffReason      String?   @map("staff_reason")
  staffFieldsToFix String[]  @default([]) @map("staff_fields_to_fix")
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz(6)
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedByUserId  String?   @map("decided_by_user_id") @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid

  user      User    @relation("AuthorizationCaseUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("AuthorizationCaseDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, status])
  @@index([status, submittedAt])
  @@map("authorization_cases")
}

model Server {
  id              String  @id @default(uuid()) @db.Uuid
  name            String  @unique
  ipAddress       String  @map("ip_address")
  notes           String?
  controlPanelUrl String? @map("control_panel_url")

  vpsNodes         VpsNode[]
  alerts           Alert[]
  enrollmentTokens ServerEnrollmentToken[]
  discoveries      WebsiteDiscovery[]
  agentCommands    AgentCommand[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("servers")
}

model ServerEnrollmentToken {
  id        String                @id @default(uuid()) @db.Uuid
  serverId  String                @map("server_id") @db.Uuid
  tokenHash String                @unique @map("token_hash")
  status    EnrollmentTokenStatus @default(ACTIVE)
  expiresAt DateTime?             @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?             @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime?             @map("revoked_at") @db.Timestamptz(6)

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([serverId, status])
  @@map("server_enrollment_tokens")
}

model VpsNode {
  id       String  @id @default(uuid()) @db.Uuid
  serverId String  @map("server_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid

  // Installation-scoped UUID generated and persisted by the Phase 1 agent.
  agentInstanceId String @unique @map("agent_instance_id")

  name      String
  secretKey String @map("secret_key")

  // Latest agent/server state. These are mutable snapshot fields, not time-series.
  status                   VpsNodeStatus @default(UNKNOWN)
  hostname                 String?
  publicIp                 String?       @map("public_ip")
  osName                   String?       @map("os_name")
  osVersion                String?       @map("os_version")
  kernelVersion            String?       @map("kernel_version")
  agentVersion             String?       @map("agent_version")
  lastSeenAt               DateTime?     @map("last_seen_at") @db.Timestamptz(6)
  lastHeartbeatAt          DateTime?     @map("last_heartbeat_at") @db.Timestamptz(6)
  credentialsRevokedAt     DateTime?     @map("credentials_revoked_at") @db.Timestamptz(6)
  credentialsRevokedReason String?       @map("credentials_revoked_reason")

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  websites    Website[]
  discoveries WebsiteDiscovery[]

  agentCommands           AgentCommand[]
  // Time-series metrics. Keep append-only for easy TimescaleDB migration later.
  vpsMetrics              VpsMetric[]
  webMetrics              WebMetric[]
  filesystemMetrics       VpsFilesystemMetric[]
  networkInterfaceMetrics VpsNetworkInterfaceMetric[]
  serviceMetrics          VpsServiceMetric[]

  alerts Alert[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([serverId])
  @@index([userId])
  @@index([status])
  @@index([lastSeenAt])
  @@map("vps_nodes")
}

model Website {
  id                 String                    @id @default(uuid()) @db.Uuid
  userId             String?                   @map("user_id") @db.Uuid
  tenantId           String                    @map("tenant_id") @db.Uuid
  vpsNodeId          String?                   @map("vps_node_id") @db.Uuid
  planId             String?                   @map("plan_id") @db.Uuid
  planActivatedAt    DateTime?                 @map("plan_activated_at") @db.Timestamptz(6)
  managementCoverage WebsiteManagementCoverage @default(UNCLASSIFIED) @map("management_coverage")

  domain      String  @unique
  displayName String? @map("display_name")

  // Inventory fields discovered by the agent from DirectAdmin/LiteSpeed.
  directAdminUser String? @map("direct_admin_user")
  homeDirectory   String? @map("home_directory")
  documentRoot    String? @map("document_root")

  wordpressAdminUrl      String?                @map("wordpress_admin_url")
  wordpressAdminUsername  String?                @map("wordpress_admin_username")
  wordpressAdminPassword String?                @map("wordpress_admin_password")

  directAdminUrl      String?                @map("direct_admin_url")
  directAdminUsername  String?                @map("direct_admin_username")
  directAdminPassword String?                @map("direct_admin_password")

  isActive          Boolean                @default(true) @map("is_active")
  status            WebsiteLifecycleStatus @default(ACTIVE)

  // Latest website status snapshot for fast dashboard cards.
  // Historical probe data is stored in WebsiteProbeMetric.
  lastIsUp           Boolean?  @map("last_is_up")
  lastStatusCode     Int?      @map("last_status_code")
  lastResponseTimeMs Int?      @map("last_response_time_ms")
  lastProbeAt        DateTime? @map("last_probe_at") @db.Timestamptz(6)

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vpsNode VpsNode? @relation(fields: [vpsNodeId], references: [id], onDelete: SetNull)
  plan    Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)

  metrics               WebMetric[]
  probeMetrics          WebsiteProbeMetric[]
  sslMetrics            WebsiteSslMetric[]
  ssl                   SSLCertificate?
  alerts                Alert[]
  discoveries           WebsiteDiscovery[]
  planRequests          PlanRequest[]
  complementaryRequests ComplementaryServiceRequest[]
  tickets               Ticket[]
  activities            Activity[]
  unixseeMessages       UnixseeMessage[]
  operationalActions    OperationalAction[]
  billingItems          BillingItem[]

  trafficSnapshots WebsiteTrafficSnapshot[]
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([tenantId])
  @@index([vpsNodeId])
  @@index([planId])
  @@index([isActive])
  @@index([status])
  @@index([lastIsUp])
  @@map("websites")
}

model WebsiteDiscovery {
  id                       String          @id @default(uuid()) @db.Uuid
  serverId                 String          @map("server_id") @db.Uuid
  vpsNodeId                String?         @map("vps_node_id") @db.Uuid
  websiteId                String?         @map("website_id") @db.Uuid
  domain                   String
  displayName              String?         @map("display_name")
  virtualHostName          String?         @map("virtual_host_name")
  discoveredAt             DateTime?       @map("discovered_at") @db.Timestamptz(6)
  isPresent                Boolean         @default(true) @map("is_present")
  removedAt                DateTime?       @map("removed_at") @db.Timestamptz(6)
  directAdminUser          String?         @map("direct_admin_user")
  homeDirectory            String?         @map("home_directory")
  documentRoot             String?         @map("document_root")
  aliases                  String[]        @default([])
  appType                  String?         @map("app_type")
  source                   String?
  backendAddress           String?         @map("backend_address")
  controlPanelUrl          String?         @map("control_panel_url")
  wordpressAdminUrl        String?         @map("wordpress_admin_url")
  wordpressVersion         String?         @map("wordpress_version")
  phpVersion               String?         @map("php_version")
  phpVersionScope          String?         @map("php_version_scope")
  imagickVersion           String?         @map("imagick_version")
  wordpressUpdateStatus    String?         @map("wordpress_update_status")
  wordpressUpdateCheckedAt DateTime?       @map("wordpress_update_checked_at") @db.Timestamptz(6)
  fieldStatus              Json?           @map("field_status")
  status                   DiscoveryStatus @default(NEW)
  stackCheckedAt           DateTime?       @map("stack_checked_at") @db.Timestamptz(6)
  stackLastSucceededAt     DateTime?       @map("stack_last_succeeded_at") @db.Timestamptz(6)
  rawPayload               Json?           @map("raw_payload")
  assignedAt               DateTime?       @map("assigned_at") @db.Timestamptz(6)
  lastIngestedAt           DateTime?       @map("last_ingested_at") @db.Timestamptz(6)

  server  Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  vpsNode VpsNode? @relation(fields: [vpsNodeId], references: [id], onDelete: SetNull)
  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  activeVisitorSamples WebsiteActiveVisitorSample[]

  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  trafficSnapshot WebsiteTrafficSnapshot?
  agentCommands   AgentCommand[]
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([serverId, domain])
  @@index([status])
  @@index([vpsNodeId])
  @@map("website_discoveries")
}

/// Phase 1 agent 3-minute unique-IP visitor samples (append-only).
/// Latest traffic snapshot only. Historical Phase 1 rows remain in
/// WebsiteActiveVisitorSample but the v0.2 agent does not append to it.
model WebsiteTrafficSnapshot {
  discoveryId String  @id @map("discovery_id") @db.Uuid
  websiteId   String? @map("website_id") @db.Uuid
  domain      String

  activeVisitorCount    Int?      @map("active_visitor_count")
  activeWindowSeconds   Int?      @map("active_window_seconds")
  activeWindowStartedAt DateTime? @map("active_window_started_at") @db.Timestamptz(6)
  activeMeasuredAt      DateTime? @map("active_measured_at") @db.Timestamptz(6)
  activeStatus          Json?     @map("active_status")

  uniqueVisitors24h          Int?      @map("unique_visitors_24h")
  visitors24hWindowSeconds   Int?      @map("visitors_24h_window_seconds")
  visitors24hCoverageSeconds Int?      @map("visitors_24h_coverage_seconds")
  visitors24hMeasuredAt      DateTime? @map("visitors_24h_measured_at") @db.Timestamptz(6)
  visitors24hAlgorithm       String?   @map("visitors_24h_algorithm")
  visitors24hStatus          Json?     @map("visitors_24h_status")

  discovery WebsiteDiscovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)
  website   Website?         @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([websiteId])
  @@index([domain])
  @@map("website_traffic_snapshots")
}

model AgentCommand {
  id          String             @id @default(uuid()) @db.Uuid
  serverId    String             @map("server_id") @db.Uuid
  vpsNodeId   String             @map("vps_node_id") @db.Uuid
  discoveryId String             @map("discovery_id") @db.Uuid
  requestedBy String             @map("requested_by") @db.Uuid
  domain      String
  type        AgentCommandType
  status      AgentCommandStatus @default(QUEUED)
  dedupeKey   String?            @unique @map("dedupe_key")

  requestedAt    DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  leasedAt       DateTime? @map("leased_at") @db.Timestamptz(6)
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  attemptCount   Int       @default(0) @map("attempt_count")
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  errorCode      String?   @map("error_code")
  resultMetadata Json?     @map("result_metadata")

  server    Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  vpsNode   VpsNode          @relation(fields: [vpsNodeId], references: [id], onDelete: Cascade)
  discovery WebsiteDiscovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)
  requester User             @relation("AgentCommandRequester", fields: [requestedBy], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([vpsNodeId, status, requestedAt])
  @@index([discoveryId, requestedAt(sort: Desc)])
  @@map("agent_commands")
}

model WebsiteActiveVisitorSample {
  recordedAt      DateTime @map("recorded_at") @db.Timestamptz(6)
  discoveryId     String   @map("discovery_id") @db.Uuid
  websiteId       String?  @map("website_id") @db.Uuid
  domain          String
  uniqueIpCount   Int      @map("unique_ip_count")
  windowSeconds   Int      @map("window_seconds")
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  measuredAt      DateTime @map("measured_at") @db.Timestamptz(6)

  discovery WebsiteDiscovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@id([recordedAt, discoveryId])
  @@index([websiteId, measuredAt])
  @@index([domain, measuredAt])
  @@map("website_active_visitor_samples")
}

// -----------------------------------------------------------------------------
// APPEND-ONLY TIME-SERIES TABLES
// -----------------------------------------------------------------------------
// Rules:
// 1. Do not use a single serial/uuid id on metric tables.
// 2. Use recorded_at + entity id as the composite primary key.
// 3. Do not UPDATE metric rows. Insert new rows only.
// 4. Keep recorded_at as TIMESTAMP WITH TIME ZONE.
// 5. Later, convert only these metric tables to TimescaleDB hypertables.
// -----------------------------------------------------------------------------

model VpsMetric {
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)
  vpsNodeId  String   @map("vps_node_id") @db.Uuid

  // CPU and load.
  cpuUsagePercent Float  @map("cpu_usage_percent")
  cpuCoreCount    Int?   @map("cpu_core_count")
  load1           Float? @map("load_1")
  load5           Float? @map("load_5")
  load15          Float? @map("load_15")

  // Memory and swap.
  memoryTotalMB     Int  @map("memory_total_mb")
  memoryUsedMB      Int  @map("memory_used_mb")
  memoryAvailableMB Int? @map("memory_available_mb")
  swapTotalMB       Int? @map("swap_total_mb")
  swapUsedMB        Int? @map("swap_used_mb")

  // Process/system health.
  processCount  Int?    @map("process_count")
  uptimeSeconds BigInt? @map("uptime_seconds")

  // LiteSpeed/global webserver pressure.
  liteSpeedConnections Int @default(0) @map("litespeed_connections")

  // Disk I/O.
  diskReadBytesPerSecond  BigInt @map("disk_read_bytes_per_second")
  diskWriteBytesPerSecond BigInt @map("disk_write_bytes_per_second")
  diskIops                Int    @map("disk_iops")

  // Coarse total storage. Detailed per-mount data is in VpsFilesystemMetric.
  storageTotalMB     Int @map("storage_total_mb")
  storageAvailableMB Int @map("storage_available_mb")

  // Coarse total network. Detailed per-interface data is in VpsNetworkInterfaceMetric.
  networkRxBytesPerSecond BigInt @map("network_rx_bytes_per_second")
  networkTxBytesPerSecond BigInt @map("network_tx_bytes_per_second")

  // Ingestion timestamp for backend debugging. This is not the metric bucket time.
  ingestedAt DateTime @default(now()) @map("ingested_at") @db.Timestamptz(6)

  vpsNode VpsNode @relation(fields: [vpsNodeId], references: [id], onDelete: Cascade)

  @@id([recordedAt, vpsNodeId])
